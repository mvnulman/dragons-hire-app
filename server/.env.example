NODE_ENV=development
PORT=3001

# PostgreSQL connection string (Neon, Supabase, Railway or a local instance)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dragons_hire

# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=replace-with-a-32-character-or-longer-secret

# Public URL of this API (used by Better Auth for cookies/callbacks)
BETTER_AUTH_URL=http://localhost:3001

# Origin of the Next.js app (CORS + trusted auth origin)
WEB_ORIGIN=http://localhost:3000
